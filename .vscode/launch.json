{
  "version": "0.8.3",
  "configurations": [
    {
      "name": "API: Uvicorn (Debug Stable)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "librarysync.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "DATABASE_URL": "postgresql+psycopg://librarysync:librarysync@localhost:5432/librarysync"
      },
      "justMyCode": true,
      "subProcess": true,
      "console": "integratedTerminal"
    },
    {
      "name": "API: Uvicorn (Reload)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "librarysync.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "DATABASE_URL": "postgresql+psycopg://librarysync:librarysync@localhost:5432/librarysync"
      },
      "justMyCode": true,
      "subProcess": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Worker: All",
      "type": "python",
      "request": "launch",
      "module": "librarysync.worker",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "DATABASE_URL": "postgresql+psycopg://librarysync:librarysync@localhost:5432/librarysync",
        "LIBRARYSYNC_WORKER_MODES": "outbox,metadata,metadata_backfill,metadata_cache,quick_import,import_all,watchlist,merge_history,merge_all_history"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + Worker",
      "configurations": ["API: Uvicorn (Debug Stable)", "Worker: All"],
      "stopAll": true
    }
  ]
}
