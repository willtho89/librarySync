{
  "version": "0.3.0",
  "configurations": [
    {
      "name": "API: Uvicorn",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "librarysync.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src",
        "DATABASE_URL": "postgresql+psycopg://librarysync:librarysync@localhost:5432/librarysync"
      },
      "justMyCode": true,
      "subProcess": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Worker: Run",
      "type": "python",
      "request": "launch",
      "module": "librarysync_worker.main",
      "cwd": "${workspaceFolder}/worker",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src:${workspaceFolder}/worker/src",
        "DATABASE_URL": "postgresql+psycopg://librarysync:librarysync@localhost:5432/librarysync"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + Worker",
      "configurations": ["API: Uvicorn", "Worker: Run"],
      "stopAll": true
    }
  ]
}
