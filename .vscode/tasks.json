{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv: sync",
      "type": "shell",
      "command": "uv",
      "args": ["sync", "--all"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ruff: lint (backend)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "check", "backend/src"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ruff: lint (worker)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "check", "worker/src"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ruff: format (backend)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "format", "backend/src"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ruff: format (worker)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "ruff", "format", "worker/src"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: start db",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "db"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: stop db",
      "type": "shell", 
      "command": "docker",
      "args": ["compose", "stop", "db"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker: reset db",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "down", "-v", "db", "&&", "docker", "compose", "up", "-d", "db"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "migrate: up",
      "type": "shell",
      "command": "uv",
      "args": ["run", "alembic", "upgrade", "head"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "dependsOn": ["docker: start db"]
    },
    {
      "label": "migrate: create",
      "type": "shell", 
      "command": "uv",
      "args": ["run", "alembic", "revision", "--autogenerate", "-m", "${input:message}"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "message",
      "description": "Migration message",
      "default": "auto migration",
      "type": "promptString"
    }
  ]
}
