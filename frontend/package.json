{
  "name": "librarysync-frontend",
  "private": true,
  "dependencies": {
    "chart.js": "^4.4.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:chart",
    "build:css": "tailwind -i ./input.css -o ../backend/src/librarysync/static/styles.css",
    "build:chart": "cp node_modules/chart.js/dist/chart.umd.min.js ../backend/src/librarysync/static/chart.min.js && cp node_modules/chart.js/dist/chart.umd.min.js.map ../backend/src/librarysync/static/chart.umd.min.js.map"
  }
}
