# Database
POSTGRES_DB=librarysync
POSTGRES_USER=librarysync
POSTGRES_PASSWORD=librarysync
DATABASE_URL=postgresql+psycopg://librarysync:librarysync@db:5432/librarysync

# App
LIBRARYSYNC_SECRET_KEY=change_me
LIBRARYSYNC_ADMIN_API_KEY=your_admin_api_key
LIBRARYSYNC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Use -1 to import full history.
HISTORY_LOOKBACK_DAYS=30
LIBRARYSYNC_JWT_ACCESS_TOKEN_MINUTES=60
LIBRARYSYNC_JWT_ALGORITHM=HS256
LIBRARYSYNC_ALLOW_REGISTRATION=true
LIBRARYSYNC_GZIP_ENABLED=true
LIBRARYSYNC_GZIP_MIN_SIZE=500
# Enable or disable dashboard statistics (set to false to disable)
LIBRARYSYNC_ENABLE_DASHBOARD_STATS=true

# OAuth
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret
SIMKL_CLIENT_ID=your_simkl_client_id
SIMKL_CLIENT_SECRET=your_simkl_client_secret
ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_anilist_client_secret

# Worker modes
LIBRARYSYNC_WORKER_MODES=all
LIBRARYSYNC_WORKER_OUTBOX_CONCURRENCY=1
LIBRARYSYNC_WORKER_METADATA_CONCURRENCY=1
LIBRARYSYNC_WORKER_QUICK_IMPORT_CONCURRENCY=1
LIBRARYSYNC_WORKER_IMPORT_ALL_CONCURRENCY=1

# Rate limits (per user, per provider, per minute)
LIBRARYSYNC_TRAKT_RATE_LIMIT_PER_MINUTE=60
LIBRARYSYNC_SIMKL_RATE_LIMIT_PER_MINUTE=60
LIBRARYSYNC_LETTERBOXD_RATE_LIMIT_PER_MINUTE=30
LIBRARYSYNC_STREMIO_RATE_LIMIT_PER_MINUTE=120
LIBRARYSYNC_ANILIST_RATE_LIMIT_PER_MINUTE=90
