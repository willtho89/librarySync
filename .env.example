# Database
POSTGRES_DB=librarysync
POSTGRES_USER=librarysync
POSTGRES_PASSWORD=librarysync
DATABASE_URL=postgresql+psycopg://librarysync:librarysync@db:5432/librarysync

# App
# Required. Signs logins and encrypts stored provider credentials; the app refuses to start
# with an empty or placeholder value. Generate one with: openssl rand -hex 32
LIBRARYSYNC_SECRET_KEY=
# When rotating the key, list the old value(s) here (comma-separated) so stored credentials
# are re-encrypted under the new key on the next start.
LIBRARYSYNC_SECRET_KEY_PREVIOUS=
# Admin endpoints are disabled while this is empty. Generate one with: openssl rand -hex 32
LIBRARYSYNC_ADMIN_API_KEY=
LIBRARYSYNC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Use -1 to import full history.
HISTORY_LOOKBACK_DAYS=30
LIBRARYSYNC_JWT_ACCESS_TOKEN_MINUTES=60
LIBRARYSYNC_JWT_ALGORITHM=HS256
LIBRARYSYNC_ALLOW_REGISTRATION=true
LIBRARYSYNC_MAX_USERS=1
LIBRARYSYNC_GZIP_ENABLED=true
LIBRARYSYNC_GZIP_MIN_SIZE=500
# Enable or disable dashboard statistics (set to false to disable)
LIBRARYSYNC_ENABLE_DASHBOARD_STATS=true
# Allow external catalogs and custom provider API URLs on private/LAN addresses (SSRF guard opt-out)
LIBRARYSYNC_ALLOW_PRIVATE_URLS=false

# OAuth
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret
SIMKL_CLIENT_ID=your_simkl_client_id
SIMKL_CLIENT_SECRET=your_simkl_client_secret
ANILIST_CLIENT_ID=your_anilist_client_id
ANILIST_CLIENT_SECRET=your_anilist_client_secret

# Worker modes (comma-separated subset of `outbox`, `metadata`, `metadata_backfill`, `metadata_cache`, `quick_import`, `import_all`, `watch_state`, `external_catalog_refresh`, `watchlist`, `merge_history`, `merge_all_history`, `retention`)
LIBRARYSYNC_WORKER_MODES=all
# Optional stable worker identity for leases (defaults to the hostname plus a random suffix)
LIBRARYSYNC_WORKER_ID=
LIBRARYSYNC_WORKER_OUTBOX_CONCURRENCY=1
LIBRARYSYNC_WORKER_METADATA_CONCURRENCY=1
LIBRARYSYNC_WORKER_QUICK_IMPORT_CONCURRENCY=1
LIBRARYSYNC_WORKER_IMPORT_ALL_CONCURRENCY=1
LIBRARYSYNC_WORKER_METADATA_CACHE_CONCURRENCY=1
LIBRARYSYNC_WORKER_EXTERNAL_CATALOG_REFRESH_CONCURRENCY=1
LIBRARYSYNC_EXTERNAL_CATALOG_REFRESH_HOURS=3
LIBRARYSYNC_EXTERNAL_CATALOG_MAX_ITEMS=500

# Outbox delivery and retention
# Retryable failures give up after this many attempts (provider throttling does not count)
LIBRARYSYNC_OUTBOX_MAX_ATTEMPTS=48
# Jobs left in progress longer than this (e.g. after a worker crash) are requeued
LIBRARYSYNC_OUTBOX_STALE_MINUTES=30
# Days to keep finished outbox jobs and metadata lookups (0 keeps them forever)
LIBRARYSYNC_OUTBOX_RETENTION_DAYS=90
LIBRARYSYNC_LOOKUP_RETENTION_DAYS=30

# Rate limits (per user, per provider, per minute)
LIBRARYSYNC_TRAKT_RATE_LIMIT_PER_MINUTE=60
LIBRARYSYNC_SIMKL_RATE_LIMIT_PER_MINUTE=60
LIBRARYSYNC_LETTERBOXD_RATE_LIMIT_PER_MINUTE=30
LIBRARYSYNC_STREMIO_RATE_LIMIT_PER_MINUTE=120
LIBRARYSYNC_ANILIST_RATE_LIMIT_PER_MINUTE=90
LIBRARYSYNC_PUBLICMETADB_RATE_LIMIT_PER_MINUTE=120
# PublicMetaDB limits are request-window based.
LIBRARYSYNC_PUBLICMETADB_RATE_LIMIT_MAX_REQUESTS=300
LIBRARYSYNC_PUBLICMETADB_RATE_LIMIT_INTERVAL_SECONDS=10
# Reserved for future /api/batch use.
LIBRARYSYNC_PUBLICMETADB_BATCH_RATE_LIMIT_MAX_REQUESTS=3
LIBRARYSYNC_PUBLICMETADB_BATCH_RATE_LIMIT_INTERVAL_SECONDS=1
LIBRARYSYNC_TMDB_RATE_LIMIT_PER_MINUTE=150
LIBRARYSYNC_TVDB_RATE_LIMIT_PER_MINUTE=150

# Maximum batch sizes for batch-capable providers
# Trakt: Maximum number of items per batch request (default: 750)
LIBRARYSYNC_TRAKT_MAX_BATCH_SIZE=750
# SIMKL: Maximum number of items per batch request (default: 750)
LIBRARYSYNC_SIMKL_MAX_BATCH_SIZE=750
